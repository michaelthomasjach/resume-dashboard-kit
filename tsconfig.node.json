{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Pas de `noEmit` : un projet référencé (`composite`) doit pouvoir émettre ses fichiers
    // d'information, sinon TypeScript refuse la référence (TS6310). Rien n'est écrit pour autant,
    // `emitDeclarationOnly` cantonne la sortie aux déclarations.
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
