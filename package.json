{
  "name": "@michaelthomasjach/resume-dashboard-kit",
  "version": "0.3.2",
  "description": "Les composants de @michaelthomasjach/liseuse-dashboard-kit, habillés du style graphique du CV de Michael Jach : bleu électrique, Space Mono et League Spartan, angles droits. Surfaces claire et sombre.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelthomasjach/resume-dashboard-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist-lib/resume-dashboard-kit.cjs.js",
  "module": "./dist-lib/resume-dashboard-kit.es.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/resume-dashboard-kit.es.js",
      "require": "./dist-lib/resume-dashboard-kit.cjs.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "files": [
    "dist-lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "npm run docgen && storybook build -o storybook-static",
    "docgen": "node scripts/docgen.mjs",
    "build:lib": "tsc --noEmit && vite build --config vite.config.lib.ts",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@fontsource/league-spartan": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@michaelthomasjach/liseuse-dashboard-kit": "^0.190.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.5.6",
    "@storybook/react": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "storybook": "10.5.6",
    "typescript": "~5.6.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.4"
  }
}
